# Copy this file to `.env.local` and fill in your own values. `.env.local` is
# gitignored so your secrets are never committed.

# Teams demo approval card delivery.
# Paste the HTTP URL from your Teams "Post to a chat when a webhook request is
# received" workflow after the = sign (no quotes), then rebuild and push:
#   npm run build ; pac code push
VITE_TEAMS_APPROVAL_WEBHOOK_URL=

# Optional: separate webhook for @mention notification cards. When unset it
# falls back to the approval webhook above.
VITE_TEAMS_MENTION_WEBHOOK_URL=
